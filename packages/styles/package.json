{
  "name": "@bolerish/edge-styles",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/assets/edge.css"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/package-license.ts",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@bolerish/edge-core": "workspace:^"
  },
  "devDependencies": {
    "vite": "catalog:2026-11-03--vite-vitest-stable",
    "vitest": "catalog:2026-11-03--vite-vitest-stable",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:"
  },
  "description": "Plain CSS and surface bindings for Edge directional lighting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bolerish/wisp.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/bolerish/wisp#readme",
  "bugs": {
    "url": "https://github.com/bolerish/wisp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
