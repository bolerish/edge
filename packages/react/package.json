{
  "name": "@bolerish/edge",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/assets/edge.css"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/package-license.ts",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:unit": "vitest run --exclude \"src/**/*.integration.test.*\"",
    "test:integration": "vitest run src/surface/Surface.integration.test.tsx src/surface/useSurface.integration.test.tsx"
  },
  "dependencies": {
    "@bolerish/edge-core": "workspace:^",
    "@bolerish/edge-styles": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "catalog:2026-11-03--react-stable",
    "react-dom": "catalog:2026-11-03--react-stable",
    "@types/react": "catalog:2026-11-03--react-stable",
    "@types/react-dom": "catalog:2026-11-03--react-stable",
    "vite": "catalog:2026-11-03--vite-vitest-stable",
    "vitest": "catalog:2026-11-03--vite-vitest-stable",
    "typescript": "catalog:",
    "jsdom": "catalog:",
    "@types/node": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:"
  },
  "description": "Shared directional border lighting for your React components.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bolerish/edge.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/bolerish/edge#readme",
  "bugs": {
    "url": "https://github.com/bolerish/edge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
