{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/index.ts",
    "!src/**/*.test.*"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "../../.private/mutation/core/index.html"
  },
  "jsonReporter": {
    "fileName": "../../.private/mutation/core/report.json"
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ]
}
