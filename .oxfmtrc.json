{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".private/**",
    "**/coverage/**",
    "**/.stryker-tmp/**",
    "**/*.tsbuildinfo",
    "**/*.gen.*",
    "**/*.min.*",
    "**/*.map",
    "pnpm-lock.yaml"
  ]
}
